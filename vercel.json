{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/aca-costos-south-florida-2025",
      "destination": "/blog/aca-costos-south-florida-2026",
      "permanent": true
    },
    {
      "source": "/blog/aca-costs-south-florida-2025",
      "destination": "/blog/aca-costs-south-florida-2026",
      "permanent": true
    },
    {
      "source": "/blog/medicare-advantage-florida-2025",
      "destination": "/blog/medicare-advantage-florida-2026",
      "permanent": true
    },
    {
      "source": "/blog/medicare-advantage-florida-2025-en",
      "destination": "/blog/medicare-advantage-florida-2026-en",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacidad",
      "permanent": true
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacidad",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}